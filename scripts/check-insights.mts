// READ-ONLY (mycase-rebuild): run the four new reports on real data and time them.
import { createRequire } from "module";
import path from "path";
const P: any = await import("../src/billing/portfolio.js");
const I: any = await import("../src/billing/insights.js");
const pick = (m: any, k: string) => m[k] || m.default[k];
const require = createRequire(path.resolve("functions/package.json"));
const admin = require("firebase-admin");
const { getFirestore } = require("firebase-admin/firestore");
admin.initializeApp({ credential: admin.credential.cert(require(path.join(process.env.USERPROFILE!, ".collections-secrets", "firebase-rebuild-writer.json"))) });
const db = getFirestore(admin.app(), "mycase-rebuild");
const plain = (v: any): any => (v && typeof v.toDate === "function" ? v.toDate().toISOString() : Array.isArray(v) ? v.map(plain) : v && typeof v === "object" ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, plain(x)])) : v);
const clients = (await db.collection("clients").get()).docs.map((d: any) => ({ id: d.id, ...plain(d.data()) }));
const money = (n: number) => "$" + Math.round(n).toLocaleString();
const now = new Date();
const rows = pick(P, "clientRows")(clients, now);
const byId = new Map(rows.map((r: any) => [r.id, r]));
let t = Date.now();
const trend = pick(I, "agingTrend")(clients, 12, now);
console.log(`aging trend (${Date.now() - t} ms):`);
trend.forEach((m: any) => console.log(`  ${m.key}: 0-30 ${money(m.b0)} | 31-60 ${money(m.b30)} | 61-90 ${money(m.b60)} | 90+ ${money(m.b90)} | total ${money(m.total)} (${m.clients})`));
t = Date.now();
const f = pick(I, "collectionForecast")(clients, 3, now);
console.log(`forecast (${Date.now() - t} ms): current-client rate ${(f.currentRate * 100).toFixed(0)}% | behind-client rate ${(f.behindRate * 100).toFixed(0)}%`);
f.months.forEach((m: any) => console.log(`  ${m.key}: scheduled ${money(m.scheduled)} (${m.clients}) = up to date ${money(m.upToDate)} + behind ${money(m.behind)} -> likely ${money(m.likely)}`));
t = Date.now();
const risk = pick(I, "writeOffRisk")(clients, byId, 6, now);
const tiers = risk.reduce((a: any, r: any) => ((a[r.tier] = (a[r.tier] || 0) + 1), a), {});
console.log(`write-off risk (${Date.now() - t} ms): ${risk.length} clients, ${money(risk.reduce((s: number, r: any) => s + r.owed, 0))}`, JSON.stringify(tiers));
risk.slice(0, 5).forEach((r: any) => console.log(`  ${r.name}: owes ${money(r.owed)}, last paid ${r.lastPayment ? r.lastPayment.toISOString().slice(0, 10) : "never"}`));
t = Date.now();
const h = pick(I, "planHealth")(clients, byId, now);
const hc = h.reduce((a: any, r: any) => ((a[r.key] = a[r.key] || { n: 0, owed: 0 }), a[r.key].n++, a[r.key].owed += r.owed, a), {});
console.log(`plan health (${Date.now() - t} ms):`, Object.entries(hc).map(([k, v]: any) => `${k} ${v.n} (${money(v.owed)})`).join(" | "));
h.filter((r: any) => r.key === "endsOwing").slice(0, 3).forEach((r: any) => console.log(`  ends owing: ${r.name} behind ${r.monthsBehind}, ${r.monthsLeft} left, ends ${r.endYm}, needs ${money(r.neededMonthly)}/mo vs ${money(r.regular)}`));
process.exit(0);
