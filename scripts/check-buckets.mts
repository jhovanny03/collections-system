// READ-ONLY (mycase-rebuild): do the aging buckets add up with Outstanding and each other?
import { createRequire } from "module";
import path from "path";
const P: any = await import("../src/billing/portfolio.js");
const clientRows = P.clientRows || P.default.clientRows;
const summarize = P.summarize || P.default.summarize;
const allPayments = P.allPayments || P.default.allPayments;
const require = createRequire(path.resolve("functions/package.json"));
const admin = require("firebase-admin");
const { getFirestore } = require("firebase-admin/firestore");
admin.initializeApp({ credential: admin.credential.cert(require(path.join(process.env.USERPROFILE!, ".collections-secrets", "firebase-rebuild-writer.json"))) });
const db = getFirestore(admin.app(), "mycase-rebuild");
const plain = (v: any): any => (v && typeof v.toDate === "function" ? v.toDate().toISOString() : Array.isArray(v) ? v.map(plain) : v && typeof v === "object" ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, plain(x)])) : v);
const clients = (await db.collection("clients").get()).docs.map((d: any) => ({ id: d.id, ...plain(d.data()) }));
const money = (n: number) => "$" + Math.round(n).toLocaleString();
const now = new Date();
const rows = clientRows(clients, now);
const s = summarize(rows, allPayments(clients), now);
console.log("buckets:", s.buckets.map((b: any) => `${b.label} ${money(b.amount)} (${b.clients})`).join(" | "), "| total", money(s.receivable.amount), `(${s.receivable.clients})`);
console.log("Outstanding (active plans, due by today):", money(s.outstanding), `(${s.outstandingClients})`, "| past due this month:", money(s.pastDue.amount), "| plan ended:", money(s.planEnded.amount), `(${s.planEnded.clients})`);
const activeAging = rows.filter((r: any) => r.status === "active").reduce((t: number, r: any) => t + r.aging.total, 0);
const activeOwed = rows.filter((r: any) => r.status === "active").reduce((t: number, r: any) => t + r.amountDue, 0);
const paused = rows.filter((r: any) => r.status === "paused").reduce((t: number, r: any) => t + r.aging.total, 0);
console.log("active: aging total", money(activeAging), "vs owed now", money(activeOwed), "(equal after the 15th) | paused clients' aging:", money(paused));
const bad = rows.filter((r: any) => Math.abs(r.aging.b0 + r.aging.b30 + r.aging.b60 + r.aging.b90 - r.aging.total) > 0.01 || r.aging.total < -0.01);
console.log("rows whose buckets do not add up:", bad.length);
const okolo = rows.find((r: any) => r.name.includes("OKOLO"));
console.log("Sophie Okolo:", JSON.stringify({ owed: okolo.amountDue, aging: okolo.aging.total, paidInFull: okolo.paidInFull }));
process.exit(0);
